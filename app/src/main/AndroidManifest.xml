<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- E-ink writing slate: a touchscreen is required; multitouch (pinch-zoom, two-finger
         pan) is used but the app degrades gracefully, so it is not marked required.
         NOTE: API 30 has no <uses-feature> constant for a stylus — EMR pen input is
         detected at runtime via MotionEvent.TOOL_TYPE_STYLUS / TOOL_TYPE_ERASER
         (SPEC.md §4.2). uses-feature is advisory anyway for a sideloaded APK. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />

    <!-- The whole document lives in this app's private storage. With allowBackup="true"
         and no exclusion rules, `adb backup` pulls the full note store off the device with
         no root — fine as a personal convenience on one's own tablet, not something to
         hand other people by default on a build meant for them to install and rely on
         (security audit, 2026-09-03). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.SuperDuper">

        <!-- Portrait-locked: the Nomad is a portrait writing slate and orientation
             changes force full-screen e-ink refreshes (SPEC.md §4.4/§4.5). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER category is what makes the app appear in Chauvet's
                     Settings > Apps > My Apps list (SPEC.md §2.2). -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
