<!--
  An infinity mark — the app draws on an infinite canvas, and a single continuous crossing
  loop reads cleanly at actual launcher size in a way two letterforms would not. Verified
  legible at a real 48px render before being coded here, not just at full canvas size.

  The path is authored directly in the 108x108 viewport, centred on (54,54); the
  surrounding group scales it down around that same centre point so the tips sit inside
  the adaptive-icon safe zone (the inner ~66dp circle every launcher mask is guaranteed
  not to clip) with margin, rather than by hand-adjusting the path's own coordinates.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:pathData="M 54,54 C 46,40 20,40 20,54 C 20,68 46,68 54,54 C 62,40 88,40 88,54 C 88,68 62,68 54,54 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
